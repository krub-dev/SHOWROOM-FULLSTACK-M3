{
	"name": "api-projects",
	"version": "1.0.0",
	"main": "index.js",
	"scripts": {
		"test": "jest --verbose --detectOpenHandles --forceExit",
		"test:watch": "jest --watch",
		"test:integration": "cd tests && ./run-tests.sh",
		"dev": "node server.js",
		"start": "node server.js",
		"seed": "node prisma/seed.js"
	},
	"jest": {
		"testEnvironment": "node",
		"testTimeout": 10000,
		"testMatch": [
			"**/tests/**/*.test.js"
		],
		"coveragePathIgnorePatterns": [
			"/node_modules/",
			"/prisma/"
		]
	},
	"prisma": {
		"seed": "node prisma/seed.js"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"description": "",
	"dependencies": {
		"@prisma/client": "^6.16.3",
		"cors": "^2.8.5",
		"express": "^5.1.0",
		"prisma": "^6.16.3"
	},
	"devDependencies": {
		"jest": "^30.2.0",
		"supertest": "^7.1.4"
	}
}
