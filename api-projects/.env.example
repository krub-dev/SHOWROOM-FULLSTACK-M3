
# Database Connection
# For local development with PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/showroom"

# For Railway production:
# Railway will automatically provide this via PostgreSQL service
# Copy the value from Railway dashboard → PostgreSQL → Variables → DATABASE_URL


# Server Configuration
# Port for the Express server (default: 3001)
PORT=3001

# Environment mode: development | production
NODE_ENV="development"


# Authentication
# Admin password for CRUD operations (POST, PUT, DELETE)
# ⚠️ Change this to a secure password in production!
ADMIN_PASSWORD="ironhack2025"


# Frontend URL (for CORS configuration)
# Local development: http://localhost:5173
# Production: Leave empty to allow same-origin requests
FRONTEND_URL="http://localhost:5173"
