# Database Connection
# Local: postgresql://postgres:password@localhost:5432/showroom
# Railway: Automatically provided by Railway PostgreSQL service
DATABASE_URL="postgresql://user:password@host:5432/database"

# Server Configuration
PORT=3001
NODE_ENV="development"

# Authentication
# Change this to a secure password in production
TEACHER_PASSWORD="your_teacher_password_here"

# Frontend URL (for CORS configuration)
# Local: http://localhost:5173
# Production: Your Railway frontend URL
FRONTEND_URL="http://localhost:5173"
